% shabycv.sty: plain Palatino CV layout, modeled on B. Shaby's CV.
% It redefines the Awesome-CV content macros, so cv/*.tex need no edits.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{shabycv}

% Option [numbered] keeps reverse numbering for papers and talks
\newif\ifcv@numbered
\DeclareOption{numbered}{\cv@numberedtrue}
\ProcessOptions\relax

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sc,osf]{mathpazo}
\RequirePackage[letterpaper,left=1in,right=1in,top=1.25in,bottom=1in,
  headheight=12pt,headsep=24pt]{geometry}
\RequirePackage{enumitem,etaremune,fancyhdr}
\RequirePackage[hidelinks]{hyperref}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% Running header from page 2 onward
\newcommand{\cvrunningname}{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\itshape\cvrunningname}
\fancyhead[R]{\itshape\thepage}

% Title block: {name}{address lines}{contact rows}
\newcommand{\cvtitleblock}[3]{%
  \thispagestyle{empty}%
  {\huge\bfseries #1\par}\vspace{18pt}%
  \begin{minipage}[t]{0.47\linewidth}\raggedright #2\end{minipage}%
  \begin{minipage}[t]{0.53\linewidth}%
    \begin{tabular}[t]{@{}p{5.5em}l@{}}#3\end{tabular}%
  \end{minipage}\par}

% Headings
\newcommand{\cvsection}[1]{\cv@undoskip\par\addvspace{20pt}%
  {\Large #1\par}\nobreak\vspace{10pt}\@afterheading}
\newcommand{\cvsubsection}[1]{\cv@undoskip\par\addvspace{10pt}%
  {\large\itshape #1\par}\nobreak\vspace{6pt}\@afterheading}

% Cancel the negative \vskip used in the Awesome-CV content files
\newcommand{\cv@undoskip}{\par\ifdim\lastskip<0pt \vskip-\lastskip\fi}

% Text on the left, bold date flush right (never wrapped)
\newlength{\cv@datew}
\newcommand{\cv@row}[3]{% {indent}{text}{date}
  \par\settowidth{\cv@datew}{\bfseries #3}%
  \noindent\hspace*{#1}%
  \parbox[t]{\dimexpr\linewidth-#1-\cv@datew-1.5em\relax}{\raggedright #2\strut}%
  \hfill\textbf{#3}\par}

% \cventry{role}{organization}{location}{date}{details}
\newenvironment{cventries}{\par}{\par}
\newcommand{\cventry}[5]{%
  \cv@undoskip
  \if\relax\detokenize{#2}\relax\else
    \addvspace{6pt}%
    \noindent\textbf{#2}\if\relax\detokenize{#3}\relax\else, #3\fi\par\nobreak
  \fi
  \if\relax\detokenize{#1#4}\relax\else
    \cv@row{1.5em}{\itshape #1}{#4}%
  \fi
  \if\relax\detokenize{#5}\relax\else\nobreak #5\par\fi}

% Bulleted details; forced line breaks from the old layout are ignored
\newenvironment{cvitems}{%
  \begin{itemize}[leftmargin=2.8em,labelsep=0.5em,nosep,topsep=2pt]%
  \raggedright
  \renewcommand{\newline}{\unskip\space}%
  \renewcommand{\\}{\unskip\space}}%
  {\end{itemize}}

% One-line entries: {name}{detail}{location}{date}
\newcommand{\cvhonor}[4]{\addvspace{3pt}%
  \cv@row{1.5em}{#1, #2, #3}{#4}}
% Volunteering: location moves before the description sentence
\newenvironment{cvhonors}{\par
  \renewcommand{\cvhonor}[4]{\addvspace{3pt}%
    \cv@row{1.5em}{##1, ##3. ##2}{##4}}}{\par}
\newenvironment{cvhonors_smaller}{\par\vspace{2pt}}{\par}

% Publications and talks: titles in roman, your name stays bold
\newcommand{\cvparagraph}[1]{\begingroup
  \renewcommand{\textbf}[1]{##1}#1\par\endgroup}
\ifcv@numbered
  \let\cv@oldetaremune\etaremune
  \renewcommand{\etaremune}{\cv@oldetaremune\setlength{\itemsep}{6pt}}
\else
  \renewenvironment{etaremune}{%
    \list{}{\leftmargin=1.5em \itemsep=8pt \parsep=0pt \topsep=2pt
            \labelwidth=0pt \labelsep=0pt}}{\endlist}
\fi

% No underlined links
\AtBeginDocument{\renewcommand{\underline}[1]{#1}}
\endinput
